{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/tauri.conf.json",
  "productName": "校园网自动登录",
  "version": "1.1.0",
  "identifier": "com.cumt.autologin",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/patch-android-gradle.mjs && node scripts/sync-android-icons.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "校园网自动登录",
        "width": 400,
        "height": 480,
        "resizable": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
