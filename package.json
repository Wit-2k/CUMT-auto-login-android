{
  "name": "cumt-auto-login",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:dev": "node scripts/sync-android-icons.mjs && tauri android dev",
    "android:build": "tauri android build",
    "android:build:signed": "tauri android build --target aarch64 --apk --ci && node scripts/sign-android-release-debug.mjs",
    "android:sign:release": "node scripts/sign-android-release-debug.mjs",
    "android:icons": "node scripts/sync-android-icons.mjs",
    "android:init": "tauri android init && node scripts/sync-android-icons.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.5.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.4",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vitest": "^4.1.8",
    "vue-tsc": "^2.2.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
